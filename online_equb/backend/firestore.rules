rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/super_admin/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdminOfLevel(level) {
      return isAdmin() && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.assignedLevel == level;
    }
    
    // Super Admin Collection
    match /super_admin/{document} {
      allow read, write: if isSuperAdmin();
      allow read: if isAdmin() || isUser();
    }
    
    // Admins Collection
    match /admins/{document} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
      allow update: if isSuperAdmin() || 
        (isAdmin() && request.auth.uid == resource.data.firebaseUid);
      allow delete: if isSuperAdmin();
    }
    
    // Users Collection
    match /users/{document} {
      allow read: if isAdmin() || 
        (isUser() && request.auth.uid == resource.data.firebaseUid);
      allow create: if isAdmin();
      allow update: if isAdmin() || 
        (isUser() && request.auth.uid == resource.data.firebaseUid);
      allow delete: if isAdmin();
    }
    
    // Equbs Collection
    match /equbs/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isAdmin() && 
        (isAdminOfLevel(resource.data.level) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
    
    // Payments Collection
    match /payments/{document} {
      allow read: if isAdmin() || 
        (isUser() && request.auth.uid == resource.data.firebaseUid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || 
        (isUser() && request.auth.uid == resource.data.firebaseUid);
    }
    
    // Draws Collection
    match /draws/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() && 
        (isAdminOfLevel(resource.data.level) || isSuperAdmin());
    }
    
    // Notifications Collection
    match /notifications/{document} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
    }
    
    // Transactions Collection
    match /transactions/{document} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
    }
    
    // Disputes Collection
    match /disputes/{document} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin() || 
        (isUser() && request.auth.uid == resource.data.userId);
    }
    
    // Settings Collection
    match /settings/{document} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // Audit Logs Collection
    match /audit_logs/{document} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create: if isAuthenticated();
    }
    
    // Reports Collection
    match /reports/{document} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAdmin() || isSuperAdmin();
    }

    // Legacy Fallbacks
    match /meta/{document} {
      allow read, write: if isAuthenticated();
    }
    match /equb_levels/{document} {
      allow read, write: if isAuthenticated();
    }
  }
}
