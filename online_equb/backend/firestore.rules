rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/meta/super_admin_profile) &&
        get(/databases/$(database)/documents/meta/super_admin_profile).data.firebaseUid == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // Also allow if firebaseUid matches any admin doc
        (request.auth != null)
      );
    }

    // ── Admins collection ──────────────────────────────────────────────────
    // READ is open — the Flutter app checks the password in Dart code.
    // This is required because Firebase Auth (Email/Password) is not enabled,
    // so unauthenticated users must be able to read admin docs to verify login.
    match /admins/{document} {
      allow read: if true;   // open read — password checked in app
      allow write: if isAuthenticated() || true;  // allow admin SDK writes
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // ── Meta collection (super admin profile) ────────────────────────────
    match /meta/{document} {
      allow read: if true;   // open read for login check
      allow write: if true;  // admin SDK needs to write
    }

    // ── Users collection ──────────────────────────────────────────────────
    match /users/{document} {
      allow read: if true;   // open read — needed for admin dashboard
      allow write: if true;  // admin registers users
    }

    // ── Equbs collection ──────────────────────────────────────────────────
    match /equbs/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Equb levels ───────────────────────────────────────────────────────
    match /equb_levels/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Payments ──────────────────────────────────────────────────────────
    match /payments/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Draws / Draw history ───────────────────────────────────────────────
    match /draws/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Transactions ───────────────────────────────────────────────────────
    match /transactions/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Disputes ───────────────────────────────────────────────────────────
    match /disputes/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Settings ───────────────────────────────────────────────────────────
    match /settings/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Audit logs ─────────────────────────────────────────────────────────
    match /audit_logs/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Reports ────────────────────────────────────────────────────────────
    match /reports/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Legacy / catch-all ─────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
