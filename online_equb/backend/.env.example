# ─────────────────────────────────────────────────────────────────────────────
# Online Equb Backend — Environment Variables
# Copy this file to .env and fill in real values
# On Render/Railway: add these as Environment Variables in the dashboard
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Firebase Admin SDK (from serviceAccountKey.json)
FIREBASE_USE_REAL=true
FIREBASE_PROJECT_ID=online-equb-managment-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@online-equb-managment-system.iam.gserviceaccount.com
# Paste the entire private key including -----BEGIN----- and -----END----- lines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Super Admin credentials (initial defaults — change after first login)
SUPER_ADMIN_EMAIL=abebe@gmail.com
SUPER_ADMIN_USERNAME=abebe1212
SUPER_ADMIN_PASSWORD=abebe1212

# Email Notifications (Gmail SMTP — optional but recommended)
# How to get App Password: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-app-password-16-chars
# EMAIL_FROM="Digital Equb <your-gmail@gmail.com>"

# SMS via Africa's Talking (optional — for Ethiopian +251 phone notifications)
# Sign up free at: https://africastalking.com
# AT_USERNAME=sandbox
# AT_API_KEY=your-api-key-here
# AT_SENDER_ID=EQUB
